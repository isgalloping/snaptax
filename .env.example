# Copy to .env.local for local dev: cp .env.example .env.local
# See AGENTS.md and docs/tech/09-deployment-vercel.md

DATABASE_URL=
POSTGRES_URL_NON_POOLING=
GHOST_HMAC_SECRET=
AUTH_SECRET=

# Vercel Flags (auto-provisioned on Vercel; pull locally with `vercel env pull .env.local`)
FLAGS=
FLAGS_SECRET=

# Internal test Paddle price ID (whitelist: Flags specialUsers; display/min: specialPrice, default $1)
SPECIAL_LEVEL_USER=
